#include <WiFi.h>
#include <WebServer.h>

// Wi-Fi Credentials
const char* ssid = "<SSID_HOTSPOT>";
const char* password = "<WIFI_PASSWORD>";

// Web Server
WebServer server(80);

// Pin Definitions
constexpr uint8_t SOIL_SENSOR_PIN = 34;   // ESP32 ADC pin
constexpr uint8_t PUMP_PIN = 4;

// Threshold & Timing Constants
constexpr int DRY_THRESHOLD = 3000;          // ESP32 ADC range: 0 - 4095
constexpr unsigned long DRY_DELAY_TIME = 5000;
constexpr unsigned long RUNTIME_LIMIT = 10000;

// State Variables
bool isPumpRunning = false;
unsigned long dryStartMillis = 0;
unsigned long pumpStartMillis = 0;
int globalMoistureValue = 0;

// --------------------------------------------------
// Web Dashboard
// --------------------------------------------------
void handleRoot() {

  String html;
  html.reserve(1400);

  html += F("<!DOCTYPE html><html>");
  html += F("<head><meta name='viewport' content='width=device-width, initial-scale=1.0'>");
  html += F("<meta http-equiv='refresh' content='2'>");
  html += F("<title>Smart Irrigation</title>");

  html += F("<style>");
  html += F("body{font-family:Arial;text-align:center;margin-top:50px;");
  html += F("background:#f4f4f9;color:#333;}");
  html += F(".card{background:white;padding:30px;border-radius:10px;");
  html += F("display:inline-block;box-shadow:0 4px 8px rgba(0,0,0,0.1);}");
  html += F(".status{font-size:24px;font-weight:bold;padding:10px;");
  html += F("border-radius:5px;margin-top:20px;}");
  html += F(".on{background:#4CAF50;color:white;}");
  html += F(".off{background:#f44336;color:white;}");
  html += F("</style></head><body>");

  html += F("<div class='card'>");
  html += F("<h2>Smart Irrigation System</h2>");

  html += F("<p style='font-size:18px;'>Moisture Value: <strong>");
  html += globalMoistureValue;
  html += F("</strong></p>");

  html += isPumpRunning
          ? F("<div class='status on'>PUMP STATUS: RUNNING</div>")
          : F("<div class='status off'>PUMP STATUS: IDLE</div>");

  html += F("</div></body></html>");

  server.send(200, "text/html", html);
}

// --------------------------------------------------
// WiFi Connection
// --------------------------------------------------
void connectWiFi() {

  Serial.println();
  Serial.print(F("Connecting to WiFi: "));
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println(F("WiFi connected!"));

  Serial.print(F("IP Address: "));
  Serial.println(WiFi.localIP());
}

// --------------------------------------------------
// Setup
// --------------------------------------------------
void setup() {

  Serial.begin(115200);

  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);

  // ESP32 ADC Configuration
  analogReadResolution(12); // 0 - 4095

  connectWiFi();

  server.on("/", handleRoot);
  server.begin();

  Serial.println(F("HTTP Server Started"));
  Serial.println(F("System Ready"));
}

// --------------------------------------------------
// Main Loop
// --------------------------------------------------
void loop() {

  server.handleClient();

  const unsigned long currentMillis = millis();

  globalMoistureValue = analogRead(SOIL_SENSOR_PIN);

  Serial.print(F("Moisture: "));
  Serial.print(globalMoistureValue);

  // --------------------------------------------
  // Pump Running
  // --------------------------------------------
  if (isPumpRunning) {

    Serial.println(F(" | PUMP: RUNNING"));

    const bool soilWet =
        globalMoistureValue < DRY_THRESHOLD;

    const bool timeoutReached =
        (currentMillis - pumpStartMillis) >= RUNTIME_LIMIT;

    if (soilWet || timeoutReached) {

      digitalWrite(PUMP_PIN, LOW);

      isPumpRunning = false;
      dryStartMillis = 0;

      Serial.println(F(">>> PUMP STOPPED"));
    }
  }

  // --------------------------------------------
  // Pump Idle
  // --------------------------------------------
  else {

    // Dry Condition
    if (globalMoistureValue > DRY_THRESHOLD) {

      if (dryStartMillis == 0) {
        dryStartMillis = currentMillis;
      }

      const unsigned long elapsedDryTime =
          currentMillis - dryStartMillis;

      Serial.print(F(" | PUMP: OFF | DRY ("));
      Serial.print(elapsedDryTime / 1000);
      Serial.println(F("s / 5s)"));

      // Start Pump after 5s dry
      if (elapsedDryTime >= DRY_DELAY_TIME) {

        digitalWrite(PUMP_PIN, HIGH);

        isPumpRunning = true;
        pumpStartMillis = currentMillis;

        Serial.println(F(">>> STARTING PUMP"));
      }
    }

    // Wet Condition
    else {

      dryStartMillis = 0;

      Serial.println(F(" | PUMP: OFF | WET"));
    }
  }

  delay(200);
}
